# Required: Discord bot token (Bot section in Discord Developer Portal)
DISCORD_BOT_TOKEN=

# pred.gg GraphQL (primary API — see https://pred.gg/gql )
# PRED_GQL_URL=https://pred.gg/gql

# OAuth2 PKCE (recommended — get client id/secret from pred.gg dev portal)
# Register redirect URI exactly as:
#   http://127.0.0.1:8765/callback
# PRED_OAUTH_CLIENT_ID=
# PRED_OAUTH_CLIENT_SECRET=
# PRED_OAUTH_REDIRECT_URI=http://127.0.0.1:8765/callback
# PRED_OAUTH_AUTHORIZE_URL=https://pred.gg/api/oauth2/authorize
# PRED_OAUTH_TOKEN_URL=https://pred.gg/api/oauth2/token
# PRED_OAUTH_SCOPE=read
# OAUTH_TOKEN_PATH=data/oauth_tokens.json
# Then run once: python -m pred_bot.auth

# Optional static Bearer (skip OAuth file if set)
# PRED_GQL_AUTHORIZATION=

# Optional Bearer used only for /build (hero.coreBuild). OAuth tokens often cannot
# access build stats; copy Authorization from browser DevTools on a pred.gg hero page.
# PRED_GQL_BUILD_AUTHORIZATION=

# Public website links in embeds
# STATS_WEB_BASE_URL=https://pred.gg

# Legacy omeda.city REST fallback for player search + match history (no auth on pred.gg for those fields)
# STATS_USE_OMEDA_FALLBACK=true
# OMEDA_BASE_URL=https://omeda.city

# Optional: seconds between follow polls (default 120)
# FOLLOW_POLL_SECONDS=120

# Optional: SQLite path for /follow state (default data/follows.sqlite3)
# DATABASE_PATH=data/follows.sqlite3

# Optional: sync slash commands to one guild for faster iteration (omit for global sync)
# GUILD_ID=

# Optional: HTTP tuning
# HTTP_MAX_CONCURRENCY=5
# HTTP_MAX_RETRIES=3

# Optional: log follow poller skip reasons
# FOLLOW_POLL_DEBUG=1

# Attach a generated scoreboard PNG to match notifications (default true)
# SCOREBOARD_IMAGE_ENABLED=true
# Optional: path to a .ttf font for scoreboard rendering (else system default)
# SCOREBOARD_FONT_PATH=
